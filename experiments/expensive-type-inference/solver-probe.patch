+package org.eclipse.jdt.internal.compiler.lookup;
+
+import java.util.Comparator;
+import java.util.IdentityHashMap;
+import java.util.Map;
+import org.eclipse.jdt.internal.compiler.ast.MessageSend;
+
+/** Single-compilation experiment for small standalone batch fixtures. */
+final class SolverProbe {
+    private static final int MAX_SITES = 2048;
+    private static final long LIMIT = 1_000_000_000L;
+    private static final Map<InvocationSite, Counts> sites = new IdentityHashMap<>();
+
+    private static final class Counts {
+        long pairs;
+        long reductions;
+    }
+    static {
+        Runtime.getRuntime().addShutdownHook(new Thread(SolverProbe::report));
+    }
+    static void record(InferenceContext18 context, long pairs, int reductions) {
+        InvocationSite site = context.currentInvocation;
+        if (site == null) return;
+        Counts c = sites.get(site);
+        if (c == null) {
+            if (sites.size() >= MAX_SITES) return;
+            c = new Counts();
+            sites.put(site, c);
+        }
+        c.pairs = Math.min(LIMIT, c.pairs + pairs);
+        c.reductions = Math.min(LIMIT, c.reductions + reductions);
+    }
+    private static void report() {
+        System.err.println("probe sites=" + sites.size() + " pairTotal=" + sites.values().stream().mapToLong(c -> c.pairs).sum()
+            + " reductionTotal=" + sites.values().stream().mapToLong(c -> c.reductions).sum());
+        sites.entrySet().stream()
+            .sorted(Comparator.comparingLong((Map.Entry<InvocationSite, Counts> e) -> e.getValue().pairs).reversed()
+                .thenComparingInt(e -> e.getKey().sourceStart()))
+            .limit(6)
+            .forEach(e -> {
+                InvocationSite site = e.getKey();
+                String name = site instanceof MessageSend m ? new String(m.selector) : site.getClass().getSimpleName();
+                System.err.printf("probe site=%d..%d name=%s pairs=%d reductions=%d%n",
+                    site.sourceStart(), site.sourceEnd(), name, e.getValue().pairs, e.getValue().reductions);
+            });
+    }
+}
